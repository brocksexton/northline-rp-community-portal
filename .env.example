# Public canonical URL used for Steam OpenID callbacks.
# In production this must be https://northline.lol, not localhost.
SITE_URL=https://northline.lol
NEXT_PUBLIC_SITE_URL=https://northline.lol

# Folder that directly contains player_save_data.json, tweeter.json, server_config.json, roles.json, etc.
# Windows example: C:\Servers\sbox\data\aperp
APE_RP_DATA_PATH=C:\Servers\aperp

# Use a long random value and keep it stable between builds/restarts. Changing this logs everyone out.
# PowerShell example: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
SESSION_SECRET=replace-with-a-long-random-string

# Optional but recommended. Required for Steam names/avatars.
STEAM_API_KEY=
NORTHLINE_BOT_STEAM_PROFILE_CACHE_MS=900000

# Local-only testing helper. Keep false in production.
ENABLE_DEV_STEAM_LOGIN=false
DEV_STEAM_ID=

# Website-owned data such as profile privacy, status banners, and metric samples.
NORTHLINE_DATA_PATH=C:\Servers\northline-data

# Optional Discord webhook integrations. Keep these only in .env.local / server environment variables.
# Do not expose webhook URLs to browser-side NEXT_PUBLIC variables.
DISCORD_WEBHOOK_STATUS_NOTIFIER=
DISCORD_WEBHOOK_NEW_REGISTRATION=
DISCORD_WEBHOOK_ADMIN_AUDIT=

# Staff server administration webhooks. Keep URLs server-side only.
DISCORD_WEBHOOK_WEB_ACTION=
DISCORD_WEBHOOK_GAME_ACTION=

# Staff server administration paths / command bridge.
# Console output is read from this file when available.
NORTHLINE_SERVER_CONSOLE_LOG_PATH=C:\Servers\northline-data\server-console.log
# Optional script that receives one sanitized command string, e.g. kick/ban/say.
# If omitted, commands are written to NORTHLINE_SERVER_COMMAND_QUEUE_PATH for an external bridge to consume.
NORTHLINE_CONSOLE_COMMAND_SCRIPT=
NORTHLINE_SERVER_COMMAND_QUEUE_PATH=C:\Servers\northline-data\server-command-queue.jsonl
# Game server launcher and SteamCMD/update scripts.
NORTHLINE_START_SERVER_SCRIPT=C:\Servers\Scripts\Run-NorthboundRP.bat
NORTHLINE_UPDATE_SERVER_SCRIPT=C:\Servers\Scripts\update_sbox.bat
NORTHLINE_SERVER_PROCESS_NAMES=sbox.exe,sbox-server.exe,sboxserver.exe

# Built-in bridge process. Use this when no external console-command script exists.
NORTHLINE_SERVER_BRIDGE_SCRIPT=C:\Servers\web\scripts\server-bridge\Run-Northline-Server-Bridge.bat
NORTHLINE_BRIDGE_SKIP_EXISTING_QUEUE_ON_FIRST_RUN=true
NORTHLINE_BRIDGE_EXIT_WITH_SERVER=false
NORTHLINE_BRIDGE_RETRY_SERVER_LAUNCH=false
NORTHLINE_BRIDGE_RETRY_SERVER_LAUNCH_MS=30000
NORTHLINE_SERVER_BRIDGE_LOG_PATH=C:\Servers\northline-data\server-bridge.log

# Dedicated Discord bot integration. Keep token/secret server-side only.
# Create a bot in Discord Developer Portal, invite it with bot + applications.commands scopes,
# then run npm run bot:register once and npm run bot:start to keep it online.
DISCORD_BOT_TOKEN=
DISCORD_BOT_CLIENT_ID=
# Optional: guild-scoped commands update instantly. Omit for global commands.
DISCORD_BOT_GUILD_ID=
# Shared secret used by the bot to call /api/bot/* routes. Use a long random string.
NORTHLINE_BOT_API_SECRET=
# Optional: force the bot to use a specific website API base URL.
NORTHLINE_BOT_API_BASE_URL=https://northline.lol
# Optional role gates for bot commands. Comma-separated Discord role IDs.
NORTHLINE_BOT_ADMIN_ROLE_IDS=
NORTHLINE_BOT_MOD_ROLE_IDS=
NORTHLINE_BOT_ANNOUNCE_ROLE_IDS=
# Optional default bot visuals.
NORTHLINE_BOT_EMBED_COLOR=#1d9bf0
NORTHLINE_BOT_BANNER_URL=
# Keep false/blank unless you enabled privileged Gateway intents in Discord Developer Portal.
NORTHLINE_BOT_ENABLE_PRIVILEGED_INTENTS=false
NORTHLINE_BOT_LOG_PATH=C:\Servers\northline-data\discord-bot.log

# Optional Discord bot connection notices. The bot tails the server console log and posts join/leave embeds.
NORTHLINE_BOT_CONNECTION_NOTICES=false
NORTHLINE_BOT_CONNECTION_CHANNEL_ID=
NORTHLINE_BOT_CONNECTION_LOG_PATH=C:\Servers\northline-data\server-console.log
NORTHLINE_BOT_CONNECTION_POLL_MS=2000
NORTHLINE_BOT_CONNECTION_INCLUDE_STEAMID=true
NORTHLINE_BOT_CONNECTION_DEDUPE_MS=45000

# Discord bot death/fatality notices.
# Watches the server console log for death/killed lines, posts embeds, and writes a JSONL event history.
NORTHLINE_BOT_DEATH_NOTICES=false
NORTHLINE_BOT_DEATH_CHANNEL_ID=
NORTHLINE_BOT_DEATH_LOG_PATH=C:\Servers\northline-data\server-console.log
NORTHLINE_BOT_DEATH_POLL_MS=2000
NORTHLINE_BOT_DEATH_DEDUPE_MS=45000
NORTHLINE_BOT_DEATH_INCLUDE_STEAMID=true
NORTHLINE_BOT_DEATH_EVENTS_PATH=C:\Servers\northline-data\death-events.jsonl
NORTHLINE_BOT_PROFILE_BASE_URL=https://northline.lol/tweeter/profile

# Connection watcher notes: player join/leave notices require a SteamID64 line. A server line like "Connected to Steam" sends a server-started notice instead of an unknown-player join.

# Optional shared secret for direct game event posts, such as death tracking.
# If omitted, NORTHLINE_BOT_API_SECRET is used for /api/game-events/* routes.
NORTHLINE_GAME_EVENT_SECRET=
