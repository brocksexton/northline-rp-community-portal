# Demo environment for `npm run demo`. Safe to commit: nothing here is a real secret.
# It is passed with `node --env-file`, so every key set here wins over the same key in any
# .env.local you may have. Keys that could point at real files or services are all listed below.

SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sample data written by demo/seed.mjs (gitignored, regenerated on every run).
APE_RP_DATA_PATH=./demo/.runtime/aperp
NORTHLINE_DATA_PATH=./demo/.runtime/northline-data

# Demo-only signing key. Never reuse it for a real deployment.
SESSION_SECRET=northline-demo-only-not-a-real-secret

# Sign in without Steam: open /api/auth/steam?dev=1 (or use the Dev login button on /dashboard).
# 76561190000000001 = Marcus Vale (Developer, sees every staff page)
# 76561190000000004 = Ava Brooks (Mayor, a regular citizen view)
ENABLE_DEV_STEAM_LOGIN=true
DEV_STEAM_ID=76561190000000001
STEAM_API_KEY=

# Point the live server query at a local port with nothing on it, so the demo
# falls back to demo/.runtime/aperp/server_status.json instead of a real server.
NORTHLINE_SERVER_QUERY_HOST=127.0.0.1
NORTHLINE_SERVER_QUERY_PORT=27999
NORTHLINE_SERVER_QUERY_FALLBACK_HOSTS=127.0.0.1
NORTHLINE_SERVER_QUERY_TIMEOUT_MS=250

# Server admin tools stay harmless: no real process names, scripts, or bridge.
NORTHLINE_SERVER_PROCESS_NAMES=northline-demo-none.exe
NORTHLINE_SERVER_CONSOLE_LOG_PATH=./demo/.runtime/aperp/server_console.demo.txt
SBOX_SERVER_CONSOLE_LOG_PATH=
SBOX_SERVER_LOG_PATH=
NORTHLINE_SERVER_COMMAND_QUEUE_PATH=./demo/.runtime/northline-data/server-command-queue.jsonl
NORTHLINE_START_SERVER_SCRIPT=./demo/not-a-real-server.bat
NORTHLINE_UPDATE_SERVER_SCRIPT=./demo/not-a-real-update.bat
NORTHLINE_SERVER_BRIDGE_SCRIPT=
NORTHLINE_CONSOLE_COMMAND_SCRIPT=
NORTHLINE_SERVER_BRIDGE_LOG_PATH=./demo/.runtime/northline-data/server-bridge.log
NORTHLINE_BOT_LOG_PATH=./demo/.runtime/northline-data/discord-bot.log
NORTHLINE_BOT_DEATH_EVENTS_PATH=./demo/.runtime/northline-data/death-events.jsonl

# Discord integrations off, so demo bans and posts never reach a real server.
DISCORD_BOT_TOKEN=
DISCORD_BOT_CLIENT_ID=
DISCORD_BOT_GUILD_ID=
NORTHLINE_DISCORD_GUILD_ID=
DISCORD_GUILD_ID=
NORTHLINE_DISCORD_FORUM_CHANNEL_ID=
NORTHLINE_BOT_API_SECRET=
DISCORD_BOT_API_SECRET=
NORTHLINE_GAME_EVENT_SECRET=
DISCORD_WEBHOOK_STATUS_NOTIFIER=
DISCORD_WEBHOOK_NEW_REGISTRATION=
DISCORD_WEBHOOK_ADMIN_AUDIT=
DISCORD_WEBHOOK_WEB_ACTION=
DISCORD_WEBHOOK_GAME_ACTION=
NORTHLINE_BOT_CONNECTION_CHANNEL_ID=
NORTHLINE_BOT_DEATH_CHANNEL_ID=
